# Root env, read by apps/api (via envFilePath: ['../../.env', ...] in
# app.module.ts) and by Prisma CLI when run from packages/database.
# See packages/database/.env.example for DATABASE_URL / DIRECT_URL detail —
# on Supabase they are deliberately different connection strings.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"

# Generate a real value — do not ship the literal default below. Currently
# configuration.ts silently falls back to an insecure default if this is
# unset rather than failing startup; that's a separate, known P0 fix, not
# yet made. Set a real secret regardless of whether that guard exists.
JWT_SECRET="replace-with-a-long-random-value"
JWT_EXPIRES_IN="1h"

PORT=4000
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3000"
SWAGGER_ENABLED=true
