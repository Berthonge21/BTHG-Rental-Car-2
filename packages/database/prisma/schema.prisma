generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection — the app's own queries. On Supabase this should be
  // the Transaction pooler (port 6543, ?pgbouncer=true): short-lived
  // connections, safe under serverless/many-instance concurrency.
  url       = env("DATABASE_URL")
  // Migrations and introspection need a connection that supports prepared
  // statements, which transaction-mode pooling does not reliably provide.
  // On Supabase this should be the Session pooler (port 5432, no
  // pgbouncer=true) or a direct connection. Prisma's env() has no fallback
  // — DIRECT_URL must always be set, even to the same value as
  // DATABASE_URL, wherever there is no separate pooler (e.g. local dev).
  directUrl = env("DIRECT_URL")
}



model Notification {
  id            Int      @id @default(autoincrement())
  agencyId      Int
  reservationId Int?
  message       String   @db.VarChar(500)
  readStatus    Boolean  @default(false) @map("read_status")
  createdAt     DateTime @default(now()) @map("created_at")
  Agency        Agency   @relation(fields: [agencyId], references: [id])
  Reservation   Rental?  @relation(fields: [reservationId], references: [id])

  @@index([agencyId, readStatus])
}

model Client {
  id            Int        @id @default(autoincrement())
  name          String     @db.VarChar(100)
  firstname     String     @db.VarChar(100)
  email         String     @unique @db.VarChar(100)
  password      String     @db.VarChar(200)
  telephone     String     @db.VarChar(100)
  numPermis     String     @db.VarChar(15)
  image         String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  emailVerified Boolean    @default(false)
  role          ClientRole @default(user)
  status        Status     @default(activate)
  deactivatedAt DateTime?  @map("deactivated_at")
  address       String     @db.VarChar(150)
  city          String     @db.VarChar(100)
  rentals       Rental[]
}

model AgencyUser {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  firstname String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(200)
  image     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  role          UserRole @default(admin)
  status        Status   @default(activate)
  deactivatedAt DateTime? @map("deactivated_at")
  // Which agency this staff member belongs to. Nullable only because a
  // superAdmin has no agency; an 'admin' role user with a null agencyId is
  // an application-level integrity issue (see requireTenantScope) rather
  // than a supported state.
  agencyId      Int?
  Agency        Agency?    @relation("AgencyStaff", fields: [agencyId], references: [id])
  // Reverse of Agency.responsibleId — the agency this user is the formal
  // "responsible" contact for, distinct from agency membership above.
  ResponsibleOf Agency?    @relation("AgencyResponsible")

  @@index([agencyId])
}

model Agency {
  id            Int            @id @default(autoincrement())
  name          String         @unique @db.VarChar(50)
  address       String         @db.VarChar(200)
  email         String         @unique @db.VarChar(100)
  telephone     String         @db.VarChar(15)
  responsibleId Int            @unique
  image         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  status        Status         @default(activate)
  // Soft delete only — name/email stay globally unique even for a deleted
  // row (no partial unique index), so a deleted agency's name/email can't
  // be reused by a new one today. That's a deliberate scope limit: making
  // reuse work needs a raw-SQL partial unique index that schema.prisma
  // can't express and that could drift on a future `migrate dev`.
  deletedAt     DateTime?      @map("deleted_at")
  AgencyUser    AgencyUser     @relation("AgencyResponsible", fields: [responsibleId], references: [id])
  Staff         AgencyUser[]   @relation("AgencyStaff")
  Cars          Car[]
  Notification  Notification[]
  Parking       Parking[]
}

model Parking {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  agencyId  Int
  image     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  address   String   @db.VarChar(200)
  city      String   @db.VarChar(200)
  Car       Car[]
  Agency    Agency   @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model Car {
  id           Int            @id @default(autoincrement())
  agencyId     Int
  brand        String         @db.VarChar(100)
  model        String         @db.VarChar(100)
  year         Int
  mileage      Int
  price        Float
  registration String         @db.VarChar(20)
  parkingId    Int?
  description  String?        @db.VarChar(300)
  fuel         String         @db.VarChar(50)
  door         Int
  gearBox      String         @db.VarChar(25)
  image        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  // Soft delete — see the same note on Agency.deletedAt re: registration
  // uniqueness not being reclaimed from a deleted row.
  deletedAt    DateTime?      @map("deleted_at")
  availability Availability[]
  Agency       Agency         @relation(fields: [agencyId], references: [id])
  parking      Parking?       @relation(fields: [parkingId], references: [id])
  maintenances Maintenance[]
  rentals      Rental[]

  @@unique([agencyId, registration])
  @@index([agencyId])
  @@index([agencyId, createdAt])
}

model Rental {
  id           Int            @id @default(autoincrement())
  clientId     Int
  carId        Int
  startDate    DateTime
  endDate      DateTime
  startTime    DateTime
  endTime      DateTime
  total        Float
  status       RentalStatus   @default(reserved)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  Notification Notification[]
  // Restrict, not Cascade: a rental is the record of realized (or
  // pending) revenue. Deleting a car must never silently destroy that
  // history — retiring a vehicle should be a soft-delete/status change on
  // Car, not something that cascades into deleting bookings.
  car          Car            @relation(fields: [carId], references: [id], onDelete: Restrict)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // A GiST exclusion constraint preventing overlapping reserved/ongoing
  // bookings for the same car lives in the
  // add_indexes_and_booking_exclusion_constraint migration — Prisma's
  // schema DSL cannot express EXCLUDE constraints, so it is not
  // represented here and migrate diff will not see it.
  @@index([clientId])
  @@index([carId, status])
  @@index([status, endDate])
  @@index([carId, startDate, endDate])
}

model Maintenance {
  id          Int      @id @default(autoincrement())
  description String   @db.VarChar(350)
  carId       Int
  cost        Float
  endDate     DateTime
  startDate   DateTime
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
}

model Availability {
  id        Int      @id @default(autoincrement())
  carId     Int
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([carId, date], name: "carId_date")
}

// Answers "who did this" for privileged writes (status changes, agency
// assignment, cancellations) that previously had no trail at all. actorEmail
// is denormalized deliberately: it must stay readable even if the actor
// account is later deleted, so this can't be a foreign key to AgencyUser.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  actorEmail String   @db.VarChar(100)
  action     String   @db.VarChar(100)
  targetType String   @db.VarChar(50)
  targetId   Int
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([createdAt])
}

enum UserRole {
  admin
  superAdmin
}

enum ClientRole {
  user
}

enum RentalStatus {
  reserved
  ongoing
  completed
  cancelled
}

enum Status {
  activate
  deactivate
}
