# Runtime connection — used by the app itself for every request.
#
# Local / any plain Postgres:
#   DATABASE_URL=postgresql://user:password@localhost:5432/bthg_rentalcar
#
# Supabase: use the "Transaction pooler" connection string (port 6543,
# ?pgbouncer=true). Short-lived connections, safe under serverless or
# many-instance concurrency. Find it via the "Connect" button on your
# project dashboard → ORMs → Prisma, or Project Settings → Database →
# Connection string → Transaction pooler.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migration connection — used only by `prisma migrate` / `prisma db push`.
# Transaction-mode pooling (above) does not reliably support the prepared
# statements migrations need, so this must point somewhere that does.
#
# Local / any plain Postgres: same value as DATABASE_URL.
#
# Supabase: use the "Session pooler" (same host, port 5432, no
# ?pgbouncer=true) or a direct connection. This variable has no default —
# it must always be set, even when it's identical to DATABASE_URL.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"
